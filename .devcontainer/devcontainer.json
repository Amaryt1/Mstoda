{
  "name": "AMARYT Admin — Private GitHub Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "AMARYT Admin — Private (do not publish)",
      "onAutoForward": "openBrowserOnce",
      "protocol": "http"
    }
  },
  "postStartCommand": "bash .devcontainer/start-admin.sh",
  "remoteUser": "vscode"
}
