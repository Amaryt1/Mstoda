{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amaryt-private-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "../admin",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amaryt-auth",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
